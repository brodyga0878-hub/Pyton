config_version=5

[application]

config/name="Elite"
config/version="0.109.0"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/Орбитальный рейс"
config/custom_user_dir_name.macos="Godot/app_userdata/Орбитальный рейс"
config/custom_user_dir_name.windows="Godot/app_userdata/Орбитальный рейс"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"
config/quit_on_go_back=false
run/main_scene="res://voyage_start.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
