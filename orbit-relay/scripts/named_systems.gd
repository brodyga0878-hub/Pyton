# Separate facilities use registry ranges, while a planned port contributes only after opening.
const PERMANENT_STAFF := {
	0: Vector2i(340, 620), 1: Vector2i(220, 460), 3: Vector2i(410, 780),
	10: Vector2i(720, 1200), 11: Vector2i(490, 860),
	Catalog.GROUND_PAD: Vector2i(24, 48), Catalog.GROUND_HANGAR: Vector2i(34, 76),
	Catalog.FRINGE_ARRIVAL_PORT: Vector2i(160, 300), Catalog.FRINGE_SECOND_PORT: Vector2i(220, 410),
	Catalog.HEATHER_PORT: Vector2i(44, 94), Catalog.LIMIT_PORT: Vector2i(38, 84),
}


static func population(ports: Array) -> Vector2i:
	var total := Vector2i.ZERO
	for port: int in ports:
		total += PERMANENT_STAFF.get(port, Vector2i.ZERO)
	return total
