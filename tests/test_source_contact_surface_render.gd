extends SceneTree
# Revision routing, source-backed vertex reconstruction and a bounded actual
# worker packet. This does not certify an interpolated triangle as an exact
# arbitrary-point F581 zero, nor claim that v5 has become live collision.
const Terrain=preload("res://scripts/source_surface_terrain.gd")
const ContactTerrain=preload("res://scripts/source_contact_surface_terrain.gd")
const Packet=preload("res://scripts/source_surface_render_packet.gd")
const State=preload("res://scripts/source_surface_render_state.gd")
const Contact=preload("res://scripts/source_surface_contact_patch.gd")
const GlobalMesh=preload("res://scripts/source_global_body_mesh.gd")
const Visual=preload("res://scripts/surface_visual.gd")
const Renderer=preload("res://scripts/celestial_renderer.gd")
const REPORT:="res://validation/alignment-2026-11-13/source-contact-surface-render.json"
# Generated by the immutable source ZIP from commit abae633776275a88bf0706893a030e7497ae6ef0.
# The original helpers ran separately in that extracted project, not through
# a second copy of the current implementation under test.
const OLD_PATCH_CHECKSUM:="6110d64354fc6e79f258e75c6d08a3fb376bb7fdc2ca3adb44b13ce0ff4638cf"
const OLD_GLOBAL_KEY:="d9b811fa801e29bbe96ea7742fdca368181a5d6a174a978cc102e068ee33ed14"
class NativeSystem extends RefCounted:
	var by_id:Dictionary={}
	var settlements:Array=[]
	var system_id:=44341016
var checks:=0
var failures:=0
var evidence:Array=[]
func _initialize()->void:call_deferred("run")
func check(ok:bool,message:String)->void:
	checks+=1
	if not ok:failures+=1;push_error(message)
func plain(value:Variant)->Variant:return JSON.parse_string(JSON.stringify(value))
func system_fixture()->NativeSystem:
	var data:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/source_ground_surface_native.json"));var record:=PackedByteArray()
	for row:Dictionary in data.cases:
		if int(row.parent_model)==120:record=str(row.parent_record_hex).hex_decode();break
	var system:=NativeSystem.new();system.by_id.body={"runtime_record_hex":record.hex_encode(),"radius_km":1.0,"id":"body","landable":true}
	return system
func globe_fixture(contact:bool)->RefCounted:
	var system:=system_fixture();var globe:RefCounted=ContactTerrain.new() if contact else Terrain.new()
	if contact:globe.configure(system,"body","",ContactTerrain.CONTACT_REVISION)
	else:globe.configure(system,"body","")
	globe.latitude=0.31;globe.longitude=0.42
	return globe
func capture(globe:RefCounted)->Dictionary:
	var points:Array=[]
	for point:Vector2 in [Vector2.ZERO,Vector2(62.5,0),Vector2(0,62.5)]:points.append(Vector3(point.x,globe.raw_height(point.x,point.y),point.y))
	var frame:={"latitude":globe.latitude,"longitude":globe.longitude,"radius":globe.radius,"record_hash":State._sha(globe.source_record),"terrain_revision":globe.revision,"record_domain":State.RECORD_DOMAIN}
	return Contact.seal_capture(frame,4000.0,64,Vector2.ZERO,Vector2i(32,32),0,points,globe)

func original_v4_contract()->void:
	var old:=globe_fixture(false);check(old.configured_ok and old.revision==Terrain.REVISION_NAME,"Original v4 still configures without opting into contact-root terrain")
	var patch:=capture(old);var restored:=Contact.new()
	check(not patch.is_empty() and patch.checksum==OLD_PATCH_CHECKSUM,"Original v4 saved triangle retains the checksum produced by immutable0.21 source")
	check(patch.terrain_policy==Terrain.SAMPLE_POLICY and patch.frame.terrain_revision==Terrain.REVISION_NAME,"Original v4 triangle schema retains its original policy and revision")
	check(restored.configure(plain(patch),old) and restored.validation_samples==3,"Original saved triangle still verifies exactly three source vertices")
	check(not restored.height_at(old,12.0,8.0).is_empty(),"Original verified triangle still supports nonvertex contact lookup")
	var system:=system_fixture();var input:=GlobalMesh.snapshot(system,"body")
	check(not input.has("terrain_revision") and GlobalMesh.key(input)==OLD_GLOBAL_KEY,"Default global snapshot and key retain the immutable0.21 v4 representation")
	var renderer:=Renderer.new()
	check(renderer._source_terrain_revision==Terrain.REVISION_NAME,"Celestial renderer defaults to v4 until an explicit caller opts into v5")
	check(not renderer.set_source_terrain_revision("unknown-policy") and renderer._source_terrain_revision==Terrain.REVISION_NAME,"Unknown global geometry policy rejects without changing the default")
	renderer.free()
	evidence.append({"case":"immutable_v4_compatibility","old_source_commit":"abae633776275a88bf0706893a030e7497ae6ef0","patch_checksum":patch.get("checksum",""),"global_key":GlobalMesh.key(input)})

func explicit_v5_and_saved_patch()->void:
	var current:=globe_fixture(true);var old:=globe_fixture(false)
	check(current.configured_ok and current.revision==ContactTerrain.CONTACT_REVISION,"Explicit v5 source terrain configures with a distinct revision")
	if not current.configured_ok:return
	var patch:=capture(current);var verified:=Contact.new()
	check(not patch.is_empty() and patch.terrain_policy==ContactTerrain.HEIGHT_POLICY and patch.frame.terrain_revision==ContactTerrain.CONTACT_REVISION,"Saved v5 triangle seals the exact contact-root policy and revision")
	if patch.is_empty():return
	check(verified.configure(plain(patch),current) and verified.validation_samples==3,"Saved v5 triangle independently recomputes all three root-backed source vertices")
	var hit:=verified.height_at(current,12.0,8.0)
	check(not hit.is_empty() and plain(verified.contact_patch(current,12.0,8.0))==plain(patch),"Verified v5 triangle can cold-resave its exact plain payload before a visual worker publishes")
	check(not verified.matches(old) and verified.height_at(old,12.0,8.0).is_empty(),"An old v4 globe cannot borrow a v5 saved contact triangle for the same source record")
	var v4_patch:=capture(old);check(not verified.configure(v4_patch,current) and verified.configured_ok,"Cross-revision restore rejects atomically without discarding the prior verified v5 triangle")
	for mutation in ["revision","policy","height"]:
		var bad:Dictionary=patch.duplicate(true)
		if mutation=="revision":bad.frame.terrain_revision=Terrain.REVISION_NAME
		elif mutation=="policy":bad.terrain_policy=Terrain.SAMPLE_POLICY
		else:bad.vertices[0][1]+=1.0
		bad.checksum=Contact.checksum_for(bad)
		check(not verified.configure(bad,current) and verified.matches(current),"Edited v5 triangle rejects after public checksum recalculation: "+mutation)
	var clone:RefCounted=ContactTerrain.from_worker_state(current.capture_worker_state())
	check(clone!=null and clone.revision==ContactTerrain.CONTACT_REVISION,"V5 worker snapshot restores through the v5 sampler")
	check(Terrain.from_worker_state(current.capture_worker_state())==null,"Old v4 worker loader rejects the distinct v5 revision")
	var system:=system_fixture();var v4:=GlobalMesh.snapshot(system,"body");var v5:=GlobalMesh.snapshot(system,"body",ContactTerrain.CONTACT_REVISION)
	check(v5.get("terrain_revision")==ContactTerrain.CONTACT_REVISION and GlobalMesh.key(v5)!=GlobalMesh.key(v4),"Global worker cache keys separate v4 and explicit v5 for the same actual source record")
	check(GlobalMesh.snapshot(system,"body","unknown-policy").is_empty(),"Unknown global source revision cannot enter a worker snapshot")
	var wrong:=v5.duplicate(true);wrong.terrain_revision="unknown-policy";check(not GlobalMesh.build(wrong).get("ok",false),"Global worker rejects an edited unsupported source revision before sampling")
	var renderer:=Renderer.new();check(renderer.set_source_terrain_revision(ContactTerrain.CONTACT_REVISION) and renderer._source_terrain_revision==ContactTerrain.CONTACT_REVISION,"Explicit global renderer opt-in is available without changing ordinary defaults")
	check(renderer.set_source_terrain_revision(Terrain.REVISION_NAME) and renderer._source_terrain_revision==Terrain.REVISION_NAME,"Global renderer can return explicitly to the preserved v4 cache domain")
	renderer.free()
	evidence.append({"case":"actual_source_v5_saved_triangle","vertices_verified":verified.validation_samples,"patch_checksum":patch.checksum,"height_policy":patch.terrain_policy,"interpolated_triangle_is_native_arbitrary_point_zero":false,"full_global_v5_mesh_build_executed":false})

func bounded_actual_worker_packet()->void:
	var globe:=globe_fixture(true);var old:=globe_fixture(false)
	if not globe.configured_ok:return
	var snapshot:Dictionary=globe.capture_worker_state();var before:=var_to_bytes(snapshot);var worker:=Thread.new()
	check(worker.start(Visual._prepare_source_job.bind(snapshot,{"core_width":64.0,"core_cells":2,"include_rings":false,"kind":"rock"},"explicit-v5-worker",false))==OK,"Actual v5 renderer preparation starts on an isolated worker")
	var result:Variant=worker.wait_to_finish()
	check(result is Dictionary and result.get("ok",false),"Actual v5 worker clone produces a bounded finite packet")
	if not result is Dictionary or not result.get("ok",false):return
	check(var_to_bytes(snapshot)==before,"Worker preparation does not mutate the caller snapshot or its caches")
	var packet:Dictionary=result.packet;var state:=State.new()
	check(Packet.valid(packet) and packet.frame.terrain_revision==ContactTerrain.CONTACT_REVISION and packet.meshes[0].vertices.size()==9,"Actual v5 packet identifies its revision and nine-vertex bounded core")
	check(state.configure(packet) and state.matches(globe) and not state.matches(old),"Published v5 state matches the exact source revision and rejects the old globe")
	check(not state.height_at(globe,8.0,11.0).is_empty() and state.height_at(old,8.0,11.0).is_empty(),"Published v5 ray lookup is available only in its own frame/revision")
	for point:Vector3 in packet.meshes[0].vertices:
		check(point.y==Vector3(0,globe.raw_height(point.x,point.z),0).y,"Published v5 vertex equals the actual source-root sampler at its own grid node")
	var corrupt:Dictionary=packet.duplicate(true);corrupt.frame.terrain_revision="unknown-policy"
	check(not state.configure(corrupt) and state.matches(globe),"Unsupported replacement packet rejects atomically with the previous v5 frame retained")
	evidence.append({"case":"actual_source_v5_worker_packet","vertices":packet.meshes[0].vertices.size(),"sample_count":packet.sample_count,"source_query_count":packet.source_query_count,"terrain_revision":packet.frame.terrain_revision,"arbitrary_point_native_equivalence_claim":false,"GPU_executed":false})

func run()->void:
	original_v4_contract();explicit_v5_and_saved_patch();bounded_actual_worker_packet()
	var sources:Dictionary={}
	for file:String in ["scripts/source_surface_render_packet.gd","scripts/source_surface_render_state.gd","scripts/source_surface_contact_patch.gd","scripts/source_global_body_mesh.gd","scripts/surface_visual.gd","scripts/celestial_renderer.gd","scripts/source_contact_surface_terrain.gd","scripts/source_terrain_contact_field.gd","tests/test_source_contact_surface_render.gd"]:sources[file]=FileAccess.get_sha256("res://"+file)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(REPORT.get_base_dir()));var report:=FileAccess.open(REPORT,FileAccess.WRITE)
	report.store_string(JSON.stringify({"schema":1,"checks":checks,"failures":failures,"evidence":evidence,"sources":sources,"scope":"Preserved immutable0.21 v4 checksum/cache default plus explicit v5 policy routing, actual source-backed three-vertex saved patch and bounded isolated worker packet. No arbitrary-point source-vs-triangle contact equivalence, complete globalv5 mesh, GPU, physicalAndroid or liveF576 landing claim."},"\t"));report.close()
	print("SOURCE CONTACT SURFACE RENDER TESTS: %d checks, %d failures"%[checks,failures]);quit(1 if failures else 0)
