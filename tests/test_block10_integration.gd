 var world:=World.new();world.configure(galaxy.get_system(int(row.system_id)),str(row.layout))
 check(world.layout_mode==row.layout,"Published layout remains available "+str(row.layout))
 check(digest(world.snapshot())==row.snapshot_sha256,"Published full world snapshot/digest retained")
 check(JSON.parse_string(JSON.stringify(world.snapshot()))==row.snapshot,"Published world JSON remains unchanged")
 check(digest(world.bodies)==row.bodies_sha256 and digest(world.settlements)==row.sites_sha256,"Published body/site descriptors retained")
 check(digest(world.source_runtime_state)==row.source_runtime_sha256,"Published source record summary retained")
 check(digest(world.orbit_backend_state)==row.source_orbit_sha256,"Published orbit backend summary retained")
 check(digest(world.port_backend_state)==row.source_ports_sha256,"Published port backend summary retained")
 check(digest(world.source_physics_state)==row.source_physics_sha256,"Published physical adapter summary retained")
 for old:Dictionary in row.dates:
  var days:=float(old.days);var points:Array=[]
  for planet in world.bodies:points.append([planet.id,world.relative_au(planet,days),world.position_au(planet.id,days),world.local_meters(planet.id,days)])
  check(digest(points)==old.centres_sha256,"Published relative/absolute/local centres retained")
  check(digest([world.gravity_at(Vector3.ZERO,days),world.gravity_at(Vector3(1000,250,-500),days)])==old.gravity_sha256,"Published two-point gravity remains unchanged")
  check(JSON.parse_string(JSON.stringify(world.origin_au(days)))==old.origin_au,"Published scalar local origin retained after the published JSON encoding")
 var restored:=World.new();restored.configure(galaxy.get_system(int(row.system_id)))
 check(restored.restore(row.snapshot) and digest(restored.snapshot())==row.snapshot_sha256,"Published world restores through default decoder without migration")
func compare_port(row:Dictionary,galaxy:RefCounted)->void:
 var world:=World.new();world.configure(galaxy.get_system(int(row.system_id)),str(row.layout));world.focus_id=str(row.parent);world.selected_id=str(row.parent);world.site_id=str(row.site_id)
 var dates:Array=[]
 for days in DATES:
  dates.append({"days":days,"origin_au":world.origin_au(days),"site_position_au":world.site_position_au(str(row.site_id),days),"site_local_meters":world.site_local_meters(str(row.site_id),days),"parent_local_meters":world.local_meters(str(row.parent),days),"gravity":world.gravity_at(Vector3.ZERO,days)})
 check(digest(dates)==row.frame_sha256,"Published selected port frame retained: "+str(row.site_id))
 check(JSON.parse_string(JSON.stringify(world.snapshot()))==row.snapshot,"Published selected port save retained")
 var restored:=World.new();restored.configure(galaxy.get_system(int(row.system_id)))
 check(restored.restore(row.snapshot) and digest(restored.snapshot())==digest(world.snapshot()),"Published selected port save restores")
func compare_ground(row:Dictionary,galaxy:RefCounted)->void:
 var world:=World.new();world.configure(galaxy.get_system(int(row.system_id)),str(row.layout));world.focus_id=str(row.parent);world.selected_id=str(row.parent);world.site_id=str(row.site_id)
 var ship:=Flight.new();var surface:=Surface.new()
 check(surface.entry_error(ship,world)==row.entry_error,"Published ground entry conditions retained")
 var entered:=surface.enter(ship,world,true,"sphere-source-cities-v3")
 check(entered==row.entered and surface.message==row.message,"Published supported/unsupported ground route retained")
 if not entered:return
 check(digest(surface.snapshot())==row.surface_sha256 and digest(ship.snapshot())==row.ship_sha256,"Published initial Surface/ship save retained")
 check(digest([surface.globe.revision,surface.globe.radius,surface.globe.latitude,surface.globe.longitude,surface.globe.pad_latitude,surface.globe.pad_longitude,surface.globe.seed_value,surface.globe.selected_site_id,surface.globe.source_site_coordinates,surface.globe.flat_sites,surface.globe.city_profiles])==row.globe_parameters_sha256,"Published geographic/city profile retained")
 check(digest([surface.height_at(0,0),surface.height_at(300,200),surface.height_at(-300,-200),surface.height_at(1700,500)])==row.height_samples_sha256,"Published visible/collision height samples retained")
 check(Surface.new().restore(surface.snapshot(),ship,world)==row.initial_restore,"Published initial Surface save restores")
 ship.position=Vector3(300,surface.height_at(300,200)+surface.clearance(ship)+0.5,200);ship.velocity=Vector3.ZERO
 check(surface.touch_down(ship)==row.manual_landing,"Published off-pad manual landing retained")
 check(digest(surface.snapshot())==row.landed_surface_sha256 and digest(ship.snapshot())==row.landed_ship_sha256,"Published off-pad grounded state retained")
 check(Surface.new().restore(surface.snapshot(),ship,world)==row.landed_restore,"Published off-pad grounded state restores")
 check(surface.begin_departure(ship)==row.begin_departure,"Published off-pad automatic departure starts")
 check(digest(surface.snapshot())==row.departure_surface_sha256 and digest(ship.snapshot())==row.departure_ship_sha256,"Published departure state retained")
 check(Surface.new().restore(surface.snapshot(),ship,world)==row.departure_restore,"Published departure save restores")
func run()->void:
 check(BASELINE_JSON.sha256_text()==BASELINE_SHA256,"Immutable published baseline bytes have original SHA-256")
 var old:Dictionary=JSON.parse_string(BASELINE_JSON)
 check(old.source_commit==COMMIT and old.worlds.size()==33 and old.ports.size()==51 and old.ground.size()==63,"Published controls cover all three world families and all mapped ports")
 var galaxy:=Galaxy.new()
 for row:Dictionary in old.worlds:compare_world(row,galaxy)
 for row:Dictionary in old.ports:compare_port(row,galaxy)
 for row:Dictionary in old.ground:compare_ground(row,galaxy)
 print("BLOCK10 INTEGRATION TESTS: %d checks, %d failures; immutable0.11.11 v1/v2/v3 worlds, dock frames and surface saves; new source APIs checked separately"%[checks,failures])
 quit(1 if failures else 0)
