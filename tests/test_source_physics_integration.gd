func _initialize()->void:call_deferred("run")
func check(ok:bool,message:String)->void:
 checks+=1
 if not ok:
  failures+=1
  if failures<=20:push_error(message)
func digest(value:Variant)->String:return var_to_bytes(value).hex_encode().sha256_text()
func frozen_published_worlds()->void:
 var baseline:Dictionary=JSON.parse_string(BASELINE_JSON)
 check(baseline.commit=="1de4beba3f48858fa59702d780aa2f73a35b2102" and baseline.worlds.size()==22,"Independent published baseline identifies all11 v1 andv2 worlds")
 var galaxy:=Galaxy.new();var bodies:=0
 for row:Dictionary in baseline.worlds:
  var world:=World.new();world.configure(galaxy.get_system(int(row.system_id)),str(row.layout))
  var label:="%d/%s"%[int(row.system_id),str(row.layout)]
  check(world.layout_mode==str(row.layout) and world.source_digest==str(row.source_digest),"Published world layout and digest unchanged: "+label)
  check(digest(world.snapshot())==str(row.snapshot_sha256),"Published v1/v2 save values and native family unchanged: "+label)
  check(digest(world.bodies)==str(row.bodies_sha256) and digest(world.settlements)==str(row.sites_sha256),"Published celestial and settlement descriptors unchanged: "+label)
  var parameters:Array=[]
  for body:Dictionary in world.bodies:
   parameters.append([str(body.id),str(body.parent),str(body.kind),float(body.radius_km),float(body.mass_solar),float(body.rotation_hours),int(body.get("model_index",-1))])
  check(digest(parameters)==str(row.physical_parameters_sha256),"Published SI radius/mass/spin/model values unchanged: "+label)
  bodies+=parameters.size()
  for date:Dictionary in row.dates:
   var days:=float(date.days);var positions:Array=[]
   for body:Dictionary in world.bodies:
    positions.append([str(body.id),world.relative_au(body,days),world.position_au(str(body.id),days),world.local_meters(str(body.id),days)])
   check(digest(positions)==str(date.centres_sha256),"Published relative/absolute/local centres unchanged at%.2fd: %s"%[days,label])
   var gravity:Array=[]
   for position in [Vector3.ZERO,Vector3(1000,2000,-3000),Vector3(250000,-500000,125000)]:gravity.append([position,world.gravity_at(position,days)])
   check(digest(gravity)==str(date.gravity_sha256),"Published SI gravity samples unchanged at%.2fd: %s"%[days,label])
 check(bodies==184,"Published independent controls cover184 body descriptors acrossboth layouts")
func frozen_flight()->void:
 var baseline:Dictionary=JSON.parse_string(BASELINE_JSON);var flight:=Flight.new()
 for step in range(100):flight.step(0.05,Vector2(0.2,-0.1),0.3,Vector3(0.1,-0.2,0.3),0.2)
 check(digest(flight.snapshot())==str(baseline.flight_after_100_steps_sha256),"Published adapted flight maintains deterministic100-step SI input behavior")
func json_copy(value:Dictionary)->Dictionary:return JSON.parse_string(JSON.stringify(value))
func catalogue()->Array:return JSON.parse_string(FileAccess.get_file_as_string("res://data/ffe_worlds.json")).systems
func key(system:int,index:int,tick:int,day:int)->String:return "%d:%d:%d:%d"%[system,index,tick,day]
func prepare_native_controls()->void:
 var fixture:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/source_orbit_native.json"))
 check(fixture.source_variant=="jjffe-7e54034-q31-orbit" and fixture.source_sha256=="d919566140abfc298bc9929bc9141d92526586821f017be1336253a04bca1e72","Port controls identify uploaded source and exact JJFFE orbit variant")
 for row:Dictionary in fixture.epoch_update_cases:
  if row.get("system_id")==null or not str(row.get("source_context","")).ends_with(" / zero destination"):continue
  controls[key(int(row.system_id),int(row.local_index),int(row.tick_u32),int(row.day_u32))]=row
 var gravity:Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/source_gravity_native.json"))
 check(gravity.source_variant=="jjffe-7e54034-gravity" and gravity.object_canaries_unchanged,"Coefficient controls are independently executed source F880 with guarded objects")
 for row:Dictionary in gravity.mass_cases:coefficients[str(row.record_hex)]=int(row.expected_a4_u32)
func source_au(raw:Array)->Array:
 return [float(int(raw[0]))*(16785.0/16777216.0)/149597870700.0,float(int(raw[1]))*(16785.0/16777216.0)/149597870700.0,float(int(raw[2]))*(16785.0/16777216.0)/149597870700.0]
func raw_add(parent:Array,relative:Array)->Array:return [int(parent[0])+int(relative[0]),int(parent[1])+int(relative[1]),int(parent[2])+int(relative[2])]
func coordinates_equal(actual:Array,expected:Array)->bool:
 if actual.size()!=3 or expected.size()!=3:return false
 for axis in range(3):
  if not is_finite(float(actual[axis])) or absf(float(actual[axis])-float(expected[axis]))>maxf(1e-18,absf(float(expected[axis]))*3e-16):return false
 return true
func state(world:RefCounted)->String:
 return digest([world.snapshot(),world.bodies,world.settlements,world.requested_layout,world.orbit_backend_state,world.port_backend_state,world.source_physics_state,world._native_cache_tick,world._native_cache_day,world._native_positions_raw,world._native_relative_raw,world.native_evaluation_count])
func source_port_worlds()->void:
 var galaxy:=Galaxy.new();var total:=0;var centre_checks:=0;var physical_checks:=0
 for entry:Dictionary in catalogue():
  var world:=World.new();world.configure(galaxy.get_system(int(entry.system_id)),World.PORT_LAYOUT)
  var legacy:=World.new();legacy.configure(galaxy.get_system(int(entry.system_id)),World.NATIVE_LAYOUT)
  check(world.layout_mode==World.PORT_LAYOUT and world.preferred_layout()==World.PORT_LAYOUT,"All mapped systems explicitly enable the port-capable nativev3 layout")
  check(world.snapshot().get("schema")=="starfrontier-rebuild-world-v3" and world.snapshot().get("version")==3 and world.snapshot().get("preferred_layout")==World.PORT_LAYOUT,"Port-aware world saves identify a distinct persistentv3 family")
  check(world.source_digest!=legacy.source_digest and not world.port_backend_state.is_empty(),"Port reference frames have a separate versioned contract from nativev2 centres")
  var source_rows:Dictionary={}
  for row:Dictionary in entry.objects:source_rows[int(row.local_index)]=row
  for body:Dictionary in world.bodies:
   var old:Dictionary=legacy.by_id[str(body.id)]
   for field in ["radius_km","mass_solar","rotation_hours","kind","model_index","record_hex","runtime_record_hex"]:check(body.get(field)==old.get(field),"Port frame migration retains published local SI/record field "+field)
   check(coefficients.has(str(body.runtime_record_hex)) and int(body.get("source_a4_packed",-1))==int(coefficients.get(str(body.runtime_record_hex),-2)),"New physical metadata uses independent native F880 coefficient from actual packed record")
   var original:Dictionary=source_rows[int(body.original_index)]
   var bound:=float(original.model_radius_raw)*pow(2.0,float(original.model_scale_raw))*(16785.0/16777216.0)
   check(is_equal_approx(float(body.get("source_outer_bound_m",-1)),bound),"Original descriptor bound remains a separately labelled source value")
   physical_checks+=1
  var orbital:Array=[]
  for site:Dictionary in world.settlements:
   if int(site.type_code)>=32 and int(site.type_code)<=34:orbital.append(site)
  total+=orbital.size()
  for days in [0.0,0.25,365.25]:
   var clock:=Clock.from_elapsed_days(days);var absolute:Dictionary={}
   for body:Dictionary in world.bodies:
    var body_key:=key(world.system_id,int(body.original_index)-1,int(clock.tick_u32),int(clock.day_u32))
    check(controls.has(body_key),"Native hierarchy has an independently executed parent record")
    if not controls.has(body_key):continue
    var relative:Array=controls[body_key].expected.position_raw;var parent:=str(body.parent)
    absolute[str(body.id)]=relative.duplicate() if parent.is_empty() else raw_add(absolute[parent],relative)
   for site:Dictionary in orbital:
    var control_key:=key(world.system_id,int(site.original_index)-1,int(clock.tick_u32),int(clock.day_u32))
    check(controls.has(control_key),"Native fixture independently covers every mapped port and date")
    if not controls.has(control_key):continue
    var control:Dictionary=controls[control_key];var relative:Array=control.expected.position_raw
    check(str(site.runtime_record_hex)==str(control.record_hex),"Live port consumes the packed F878 record used by the native oracle")
    var expected:Array=source_au(raw_add(absolute[str(site.parent)],relative))
    check(coordinates_equal(world.site_position_au(str(site.id),days),expected),"Port absolute XYZ matches independent native phase/position plus raw parent chain")
    world.focus_id=str(site.parent);world.selected_id=world.focus_id;world.site_id=str(site.id)
    var local:Vector3=world.site_local_meters(str(site.id),days)
    check(local.distance_to(Flight.STATION)<0.2,"Station-following frame keeps the exact existing local autopilot/dock target")
    var parent_centre:Vector3=world.local_meters(world.focus_id,days)
    var radius:=float(world.by_id[world.focus_id].radius_km)*1000.0
    var radial:=Vector3(float(int(relative[0])),float(int(relative[1])),float(int(relative[2])))*(16785.0/16777216.0)
    check(parent_centre.distance_to(local)>radius and parent_centre.distance_to(Flight.STATION-radial)<maxf(16.0,float(radial.length())*2e-6),"True source port is outside adapted parent and preserves allXYZcomponents of its original geocentric offset")
    var count:int=world.native_evaluation_count;var returned:Array=world.site_position_au(str(site.id),days);var pristine:=returned.duplicate()
    returned[0]=1e30
    world.site_local_meters(str(site.id),days);world.gravity_at(Vector3.ZERO,days)
    check(world.site_position_au(str(site.id),days)==pristine and world.native_evaluation_count==count,"Port/frame/gravity requests share the same source clock cache and return independent arrays")
    centre_checks+=1
   world.site_id="";world.focus_id=world.default_id;world.selected_id=world.default_id
   check(legacy.gravity_at(Vector3.ZERO,days)==world.gravity_at(Vector3.ZERO,days),"Without a selected portv3 preserves the published SI gravity adapter exactly")
  world.site_id="";world.focus_id=world.default_id;world.selected_id=world.default_id
  world.position_au(world.focus_id,0.25);var old_count:int=world.native_evaluation_count
  world.position_au(world.focus_id,0.25+1.0/4294967296.0)
  check(world.native_evaluation_count==old_count+world.bodies.size()+orbital.size(),"A changed source clock calculates exactly one complete body-and-port cache")
  var saved:=json_copy(world.snapshot());var target:=World.new();target.configure(galaxy.get_system(world.system_id))
  check(target.restore(saved) and target.layout_mode==World.PORT_LAYOUT and json_copy(target.snapshot())==saved,"Legacy candidate decoder atomically reconstructs the explicit portv3 family")
  var stable:=state(target);var invalid:=saved.duplicate(true);invalid.source_digest="changed"
  check(not target.restore(invalid) and state(target)==stable,"Rejectedv3 digest cannot replace models or native port/physics caches")
  invalid=saved.duplicate(true);invalid.preferred_layout=World.NATIVE_LAYOUT
  check(not target.restore(invalid) and state(target)==stable,"Av3 save cannot silently downgrade its source port family")
  invalid=saved.duplicate(true);invalid.schema="starfrontier-rebuild-world-v2";invalid.version=2
  check(not target.restore(invalid) and state(target)==stable,"Av2 header cannot smuggle av3 port layout into an old world")
  check(target.restore(json_copy(legacy.snapshot())) and target.layout_mode==World.NATIVE_LAYOUT and target.port_backend_state.is_empty() and target.source_physics_state.is_empty(),"Restoring published nativev2 clears all new port and coefficient metadata")
  var before:=state(world)
  check(world.site_position_au("missing",0.0).is_empty() and world.site_position_au("missing",NAN).is_empty() and state(world)==before,"Unknown source ports reject without mutating the valid world cache")
  for site:Dictionary in world.settlements:
   if int(site.type_code)==35:check(world.site_position_au(str(site.id),0.0).is_empty(),"Ground ports do not enter the ordinary orbital branch")
  if not orbital.is_empty():
   var untouched:=state(world)
   for bad in [-1.0,NAN,INF,1000000001.0]:check(world.site_position_au(str(orbital[0].id),bad).is_empty() and state(world)==untouched,"Invalid source clocks cannot poison valid port caches")
 check(total==17 and centre_checks==51,"Independent controls cover all17 source orbital ports at three native dates")
 check(physical_checks==92,"New physical metadata covers all92 mapped celestial bodies")
 var sol:=World.new();sol.configure(galaxy.get_system(Galaxy.SOL_ID),World.PORT_LAYOUT)
 check(float(sol.by_id.moon.source_outer_bound_m)==4401866.25 and float(sol.by_id.mercury.source_outer_bound_m)==4401866.25 and float(sol.by_id.moon.radius_km)!=float(sol.by_id.mercury.radius_km),"Shared original bounding descriptor is kept separate from two different published physical radii")
func remove_private(path:String)->void:
 if private_directory.is_empty() or not (path==private_directory or path.begins_with(private_directory+"/")):return
 if not DirAccess.dir_exists_absolute(path):return
 for name in DirAccess.get_directories_at(path):remove_private(path+"/"+name)
 for name in DirAccess.get_files_at(path):DirAccess.remove_absolute(path+"/"+name)
 DirAccess.remove_absolute(path)
func actual_main()->void:
 var game:Node3D=load("res://scenes/main.tscn").instantiate();var settings:=MemorySettings.new();settings.quality=0;game.settings=settings
 root.add_child(game);game.set_process(false);game.set_physics_process(false);await process_frame
 check(game.automated and not game.saving_enabled and game.world.layout_mode==World.PORT_LAYOUT,"Actual new Main starts the port-capablev3 family without touching player progress")
 private_directory="user://source-physics-integration-%d"%OS.get_process_id();game.saves.directory=private_directory+"/saves"
 game.world.focus_id="earth";game.world.selected_id="earth";game.world.site_id="site13";game._apply_system()
 check(game.world.is_orbital_site() and game.ship.original_port and game.ship.station_available,"Actual source station selection activates the original-port context")
 check(game.world.site_local_meters("site13",game.nav.elapsed_days)==game.ship.STATION and game.station.position==game.ship.STATION,"Rendered station, original port frame and controller dock target agree")
 game._toggle_auto()
 for tick in range(4000):
  game._tick(0.05,Vector2.ZERO,0)
  if game.ship.docked:break
 check(game.ship.docked and game.ship.hull==100 and game.ship.position.distance_to(game.ship.STATION)<=game.ship.DOCK_RADIUS,"Actual autopilot docks a healthy ship at the source-centred station")
 var payload:=json_copy(game._payload());var before:=JSON.stringify(game._payload())
 check(game.diagnostics._json_safe(game._payload()),"Portv3 full snapshot uses strict JSON-safe ordinary keys")
 game.saving_enabled=true;check(game._save_game(),"Port-docked fullv3 flight writes only its private save")
 game.saving_enabled=false;var loaded:Dictionary=game.saves.load_valid(game._decode_state)
 check(not loaded.is_empty(),"Actual complete decoder restores the source-port-dockedv3 flight")
 if not loaded.is_empty():
  game._commit_state(loaded);game._apply_system()
  check(json_copy(game._payload())==payload and game.ship.original_port and game.ship.docked and game.world.preferred_layout()==World.PORT_LAYOUT,"Port docking save retains all progress and derived source context")
 before=JSON.stringify(game._payload())
